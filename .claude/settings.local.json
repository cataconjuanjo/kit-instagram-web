{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Grep(.env*)",
      "Grep(**/.env*)",
      "Read(**/.env*)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(type .env*)",
      "Bash(type **/.env*)",
      "Bash(more .env*)",
      "Bash(Get-Content .env*)",
      "Bash(Get-Content **/.env*)",
      "Bash(gc .env*)",
      "Bash(gc **/.env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content **/.env*)",
      "PowerShell(gc .env*)",
      "PowerShell(gc **/.env*)",
      "PowerShell(cat .env*)"
    ],
    "allow": [
      "Bash(Start-Process \"c:\\\\Users\\\\jjgar\\\\Desktop\\\\10 SKILLS ADRI Y JUANPE\\\\kit-instagram-web\\\\web-cataconjuanjo.html\")",
      "PowerShell(Start-Process \"c:\\\\Users\\\\jjgar\\\\Desktop\\\\10 SKILLS ADRI Y JUANPE\\\\kit-instagram-web\\\\web-cataconjuanjo.html\")",
      "Bash(git commit -m ' *)",
      "Bash(git add *)",
      "Bash(node -e \"const fs = require\\('fs'\\); const content = fs.readFileSync\\('app/page.js', 'utf8'\\); console.log\\('page.js OK, lines:', content.split\\('\\\\n'\\).length\\)\")",
      "PowerShell(Start-Process \"http://localhost:3000\")",
      "Bash(playwright-cli goto *)",
      "Bash(playwright-cli screenshot *)",
      "Bash(playwright-cli eval *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PWD/.claude/hooks/check-env-access.js\"",
            "timeout": 5,
            "statusMessage": "Verificando acceso a credenciales..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop."
}
